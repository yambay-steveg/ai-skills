#!/usr/bin/env bash
# brew-apply — upgrade Homebrew packages. CHANGES THINGS: confirms before each stage.
#
# The successor to the Warp workflow `brew-update.yaml`, runnable from any terminal.
# Deliberately interactive: upgrading node/python/openjdk can break toolchains mid-work,
# and casks replace whole running applications. Be present for it.
#
# For an unattended, read-only report use `brew-check` instead.
#
# Usage:
#   brew-apply                  update, then confirm formulae / casks / cleanup
#   brew-apply --formulae-only  skip the cask stage (the safer half)
#   brew-apply --casks-only     skip the formula stage
#   brew-apply --yes            assume yes (scripted use — you own the consequences)
#
# Exit status: 0 = done or nothing to do, 2 = error.

set -uo pipefail

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1

# Casks that manage their own updates — upgrading them via brew fights their updater.
# Carried over from the Warp workflow. Keep in sync with brew-check.
SELF_UPDATING_CASKS=(eset-cyber-security)

DO_FORMULAE=1
DO_CASKS=1
ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --formulae-only) DO_CASKS=0 ;;
    --casks-only)    DO_FORMULAE=0 ;;
    --yes|-y)        ASSUME_YES=1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "brew-apply: unknown option: $arg" >&2; exit 2 ;;
  esac
done

command -v brew >/dev/null 2>&1 || { echo "brew-apply: brew not found on PATH" >&2; exit 2; }

confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  # Read from the terminal, not stdin, so this still works inside a pipeline.
  local reply
  read -r -p "$1 [y/N] " reply </dev/tty || return 1
  [[ "$reply" =~ ^[Yy]$ ]]
}

echo "==> Updating Homebrew"
brew update || { echo "brew-apply: brew update failed" >&2; exit 2; }
echo

if [ "$DO_FORMULAE" -eq 1 ]; then
  formulae=$(brew outdated --formula --quiet 2>/dev/null | sed '/^$/d')
  if [ -z "$formulae" ]; then
    echo "==> Formulae: all current"
  else
    n=$(printf '%s\n' "$formulae" | wc -l | tr -d ' ')
    echo "==> Formulae outdated ($n):"
    printf '%s\n' "$formulae" | tr '\n' ' ' | fold -s -w 92 | sed 's/^/    /'
    echo
    echo "    NOTE: node / python@* / openjdk here means dependent toolchains and editors"
    echo "          may need restarting afterwards."
    if confirm "Upgrade formulae?"; then
      brew upgrade --formula
    else
      echo "    skipped."
    fi
  fi
  echo
fi

if [ "$DO_CASKS" -eq 1 ]; then
  filter=$(printf '%s\n' "${SELF_UPDATING_CASKS[@]}" | paste -sd'|' -)
  casks=$(brew outdated --cask --quiet 2>/dev/null | sed '/^$/d' | grep -Ev "^(${filter})$" || true)
  skipped=$(brew outdated --cask --quiet 2>/dev/null | sed '/^$/d' | grep -E "^(${filter})$" || true)
  [ -n "$skipped" ] && echo "==> Skipping self-updating: $(printf '%s' "$skipped" | tr '\n' ' ')"
  if [ -z "$casks" ]; then
    echo "==> Casks: all current"
  else
    n=$(printf '%s\n' "$casks" | wc -l | tr -d ' ')
    echo "==> Casks outdated ($n):"
    printf '%s\n' "$casks" | tr '\n' ' ' | fold -s -w 92 | sed 's/^/    /'
    echo
    echo "    NOTE: casks replace whole applications. Any that are running will be"
    echo "          restarted or interrupted."
    if confirm "Upgrade casks?"; then
      printf '%s\n' "$casks" | xargs -r brew upgrade --cask
    else
      echo "    skipped."
    fi
  fi
  echo
fi

# `brew cleanup` alone reclaims very little (872 MB when measured 2026-08-02).
# --prune=all clears the download cache too — that was 7.3 GB.
if confirm "Clean up old versions and the download cache (brew cleanup --prune=all)?"; then
  brew cleanup --prune=all
fi
echo

echo "==> brew doctor"
brew doctor 2>&1 | head -15

echo
echo "Done."
